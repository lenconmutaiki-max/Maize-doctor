              "                    datasets: [{\n",
              "                        data: [1, 3, 1],\n",
              "                        backgroundColor: ['#e74c3c', '#e67e22', '#f1c40f'],\n",
              "                        borderWidth: 1\n",
              "                    }]\n",
              "                },\n",
              "                options: {\n",
