              "                data: {\n",
              "                    labels: ['Armyworm', 'Streak Virus', 'Nitrogen Def.', 'Stalk Borer', 'Maize Smut'],\n",
              "                    datasets: [{\n",
              "                        label: 'Estimated Prevalence (%) in Mashonaland Central',\n",
              "                        data: [42, 18, 55, 30, 10],\n",
              "                        backgroundColor: [\n",
              "                            'rgba(231, 76, 60, 0.75)',\n",
              "                            'rgba(230, 126, 34, 0.75)',\n",
              "                            'rgba(241, 196, 15, 0.75)',\n",
              "                            'rgba(52, 152, 219, 0.75)',\n",
              "                            'rgba(155, 89, 182, 0.75)'\n",
              "                        ],\n",
              "                        borderColor: [\n",
