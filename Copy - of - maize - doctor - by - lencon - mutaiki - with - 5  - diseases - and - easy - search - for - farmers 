              "            // Headers\n",
              "            csvContent += \"Symptom ID,Disease Name,Severity,Recommended Treatment,Warning\r\n",
              "\";\n",
              "\n",
              "            // Build rows based on dataset registry\n",
              "            Object.keys(langData.diseases).forEach(key => {\n",
              "                const disease = langData.diseases[key];\n",
              "                const row = [\n",
              "                    key,\n",
              "                    `\"${disease.name.replace(/\"/g, '\"\"')}\"`,\n",
              "                    `\"${disease.severity.replace(/\"/g, '\"\"')}\"`,\n",
              "                    `\"${disease.action.replace(/\"/g, '\"\"')}\"`,\n",
              "                    `\"${(disease.warning || '').replace(/\"/g, '\"\"')}\"`\n",
              "                ].join(\",\");\n",
              "                csvContent += row + \"\r\n",
              "\";\n",
              "            });\n",
              "\n",
              "            // Process download link\n",
              "            const encodedUri = encodeURI(csvContent);\n",
              "            const link = document.createElement(\"a\");\n",
              "            link.setAttribute(\"href\", encodedUri);\n",
              "            link.setAttribute(\"download\", `maize_doctor_diagnostics_${currentLang}.csv`);\n",
              "            document.body.appendChild(link);\n",
              "            link.click();\n",
              "            document.body.removeChild(link);\n",
              "        }\n",
