              "                el.classList.remove('selected');\n",
              "            });\n",
              "            const targetEl = document.getElementById(`label-${id}`);\n",
              "            if (targetEl) {\n",
              "                targetEl.classList.add('selected');\n",
              "            }\n",
              "        }\n",
              "\n",
              "        function resetOutput() {\n",
              "            const container = document.getElementById('results-container');\n",
              "            container.className = 'results-box';\n",
              "            const defaultText = currentLang === 'en'\n",
              "                ? 'Select symptoms and run diagnosis to see expert agricultural advice.'\n",
              "                : 'Sarudzai chiratidzo chero chipi pachibage kuti muwane ruzivo rwekurapa.';\n",
              "            container.innerHTML = `<div style=\"text-align: center; color: #64748b;\"><p>${defaultText}</p></div>`;\n",
              "        }\n",
              "\n",
              "        function performDiagnosis() {\n",
              "            const selectedOption = document.querySelector('input[name=\"symptom\"]:checked');\n",
              "            if (!selectedOption) {\n",
              "                alert(database[currentLang].no_symptom);\n",
              "                return;\n",
              "            }\n",
              "\n",
              "            const key = selectedOption.value;\n",
              "            const disease = database[currentLang].diseases[key];\n",
              "\n",
              "            const container = document.getElementById('results-container');\n",
              "            container.className = 'results-box active';\n",
              "\n",
              "            let badgeClass = 'badge-moderate';\n",
              "            if (key === 'brown') badgeClass = 'badge-critical';\n",
