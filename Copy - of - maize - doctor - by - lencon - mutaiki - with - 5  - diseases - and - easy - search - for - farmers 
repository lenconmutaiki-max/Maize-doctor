              "                        ],\n",
              "                        borderWidth: 1.5\n",
              "                    }]\n",
              "                },\n",
              "                options: {\n",
              "                    responsive: true,\n",
              "                    maintainAspectRatio: false,\n",
              "                    plugins: {\n",
              "                        legend: { display: false }\n",
              "                    },\n",
              "                    scales: {\n",
              "                        y: { beginAtZero: true, max: 100 }\n",
              "                    }\n",
              "                }\n",
              "            });\n",
              "\n",
              "            const ctxUrgency = document.getElementById('urgencyChart').getContext('2d');\n",
              "            urgencyChartInstance = new Chart(ctxUrgency, {\n",
              "                type: 'doughnut',\n",
              "                data: {\n",
