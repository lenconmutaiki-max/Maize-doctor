      "source": [
        "def diagnose_maize_dict(symptom=None):\n",
        "    # Define disease data mapping\n",
        "    DISEASE_REGISTRY = {\n",
        "        \"brown\": {\n",
        "            \"diagnosis\": \"Fall Armyworm or Grey Leaf Spot\",\n",
        "            \"action\": \"Spray Lambda-Cyhalothrin early morning\",\n",
        "            \"warning\": \"Do NOT wait, it spreads in 2 days!\"\n",
        "        },\n",
        "        \"armyworm\": {\n",
        "            \"diagnosis\": \"Fall Armyworm or Grey Leaf Spot\",\n",
        "            \"action\": \"Spray Lambda-Cyhalothrin early morning\",\n",
        "            \"warning\": \"Do NOT wait, it spreads in 2 days!\"\n",
        "        },\n",
        "        \"white\": {\n",
        "            \"diagnosis\": \"Maize Streak Virus\",\n",
        "            \"action\": \"Remove infected plants. Control leafhoppers.\",\n",
        "            \"warning\": \"Plant resistant variety next season.\"\n",
        "        },\n",
        "        \"yellow\": {\n",
        "            \"diagnosis\": \"Nitrogen Deficiency - Soil is hungry\",\n",
        "            \"action\": \"Apply Ammonium Nitrate (AN) - 100kg per hectare\",\n",
        "            \"warning\": \"Your Geography: This happens in sandy soils in Mashonaland\"\n",
        "        },\n",
        "        \"holes\": {\n",
        "            \"diagnosis\": \"Stalk Borer\",\n",
        "            \"action\": \"Apply pesticide into the funnel of the maize\",\n",
        "            \"warning\": \"\"\n",
        "        },\n",
        "        \"black\": {\n",
        "            \"diagnosis\": \"Maize Smut - Black powder on cob\",\n",
        "            \"action\": \"Remove and burn infected cobs.\",\n",
        "            \"warning\": \"Do NOT keep seeds from this plant.\"\n",
        "        }\n",
        "    }\n",
        "\n",
        "    print(\"Mhoro! Welcome to Maize Doctor\")\n",
        "    print(\"I will help you check your maize\")\n",
        "    print(\"--------------------------------\")\n",
        "\n",
        "    if symptom is None:\n",
        "        symptom = input(\"What do you see on your maize? Type: brown spots / white spots / yellow leaves / holes / black spots: \")\n",
        "\n",
        "    symptom = symptom.lower()\n",
        "\n",
        "    # Find matching keyword in our registry\n",
        "    matched_key = None\n",
        "    for key in DISEASE_REGISTRY:\n",
        "        if key in symptom:\n",
        "            matched_key = key\n",
        "            break\n",
        "\n",
        "    if matched_key:\n",
        "        disease = DISEASE_REGISTRY[matched_key]\n",
        "        print(f\"\\nDIAGNOSIS: {disease['diagnosis']}\")\n",
        "        print(f\"ACTION: {disease['action']}\")\n",
        "        if disease['warning']:\n",
        "            print(disease['warning'])\n",
        "    else:\n",
        "        print(\"\\nI don't know this one yet. Take a photo and send to Agritex Officer.\")\n",
        "\n",
        "    print(\"\\n--- Built by Future Agri-AI Engineer ---\")\n",
        "\n",
        "# Quick test\n",
        "diagnose_maize_dict(symptom=\"I found black powder on my crop\")"
      ],
